{
  "name": "dsh-origin-bridge",
  "version": "0.4.5",
  "description": "在对话里驱动本机 Origin / OriginPro：导入 .dat/.csv/.txt 与电化学工作站 .bin，绘图、拟合、改样式，导出图片并保存可在 Origin 里继续编辑的 .opju 工程。dsh 插件，27 个 MCP 工具。第三方工具，与 OriginLab Corporation 无关联、未获认可。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caob23/dsh-origin-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/caob23/dsh-origin-bridge/issues"
  },
  "homepage": "https://github.com/caob23/dsh-origin-bridge#readme",
  "main": "./index.js",
  "icon": "./icon.svg",
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.1"
  },
  "bin": {
    "origin-bridge": "bin/origin-bridge.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "bin/origin-bridge.mjs",
    "install_dsh.ps1",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "docs/preview.png",
    "scripts/make_screenshots.py",
    "docs/shot-workstation.png",
    "docs/shot-heatmap.png",
    "docs/shot-eis.png",
    "docs/shot-cv.png",
    "screenshots.json",
    "scripts/make_icon.py",
    "scripts/make_preview.py",
    "server.py",
    "originlab.py",
    "asciiio.py",
    "binio.py",
    "templates_catalog.py",
    "fixtures/make_fixtures.py",
    "fixtures/*.dat",
    "fixtures/*.csv",
    "fixtures/*.txt",
    "smoke_test.py",
    "edge_checks.py",
    "test_asciiio.py",
    "test_binio.py",
    "test_lifecycle.py",
    "client_check.py",
    "requirements.txt",
    "sample.dat",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "origin",
    "originpro",
    "opju",
    "scientific-plotting",
    "electrochemistry"
  ]
}
